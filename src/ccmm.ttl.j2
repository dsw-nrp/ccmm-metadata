{%- import "src/mapping/ccmm.j2" as mapping with context -%}
{%- set dmp = mapping.ccmm["dmp"] -%}
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcso: <https://w3id.org/dcso/ns/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcs-lang: <https://w3id.org/dcso/id/iso639-3/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .  

{# URI mappings #}
{%- set uri_dmp = dmp["dmp_id"]["identifier"] -%}
{%- set uri_dmpid = uri_dmp ~ "/identifier" -%}

{%- macro make_uri(identifier, type) -%}
  {%- if identifier.startswith("http") -%}
    {{ identifier }}
  {%- elif type == "orcid" -%}
    https://orcid.org/{{ identifier }}
  {%- elif type == "doi" -%}
    https://doi.org/{{ identifier }}
  {%- elif type == "handle" -%}
    https://hdl.handle.net/{{ identifier }}
  {%- else -%}
    {{ uri_dmp }}#{{ identifier }}
  {%- endif -%}
{%- endmacro -%}

# DMP
<{{ uri_dmp }}>
  a dcso:DMP ;
  dct:title {{ dmp["title"]|tojson }} ;
  dct:description {{ dmp["description"]|tojson }} ;
  dct:language dcs-lang:{{ dmp["language"] }} ;
  dcso:ethicalIssuesExist {{ dmp["ethical_issues_exist"]|tojson }} ;
{%- if "ethical_issues_description" in dmp.keys() %}
  dcso:ethicalIssuesDescription {{ dmp["ethical_issues_description"]|tojson }} ;
{%- endif %}
{%- if "ethical_issues_report" in dmp.keys() %}
  dcso:ethicalIssuesReport {{ dmp["ethical_issues_report"]|tojson }} ;
{%- endif %}
  dcso:hasDMPId <{{ uri_dmpid }}> ;
{%- if "contact" in dmp.keys() %}
  dcso:hasContact <{{ make_uri(dmp["contact"]["contact_id"]["identifier"], dmp["contact"]["contact_id"]["type"]) }}> ;
{%- endif %}
{%- if "contributor" in dmp.keys() and dmp["contributor"]|length > 0 %}
  dcso:hasContributor
  {%- for contributor in dmp["contributor"] %}
    [ a dcso:Contributor ;
      dcso:hasContributorId
        [ a dcso:ContributorId ;
          dcso:identifierType {{ contributor["contributor_id"]["type"]|tojson }} ;
          dct:identifier {{ contributor["contributor_id"]["identifier"]|tojson }} ;
        ] ;
      {%- if "mbox" in contributor.keys() %}
      foaf:mbox {{ contributor["mbox"]|tojson }} ;
      {%- endif %}
      {%- if contributor["role"]|length > 0 %}
      dcso:role {{ contributor["role"]|map('tojson')|join(', ') }} ;
      {%- endif %}
      {%- if "name" in contributor.keys() %}
      foaf:name {{ contributor["name"]|tojson }} ;
      {%- endif %}
    ] {{ ";" if loop.last else "," }}
  {%- endfor -%}
{%- endif %}
{%- if "project" in dmp.keys() and dmp["project"]|length > 0 %}
  dcso:hasProject
  {%- for project in dmp["project"] %}
    [ a dcso:Project ;
      dct:title {{ project["title"]|tojson }} ;
      {%- if "description" in project.keys() %}
      dct:description {{ project["description"]|tojson }} ;
      {%- endif %}
      {%- if "start" in project.keys() %}
      dcso:start {{ project["start"]|tojson }}^^xsd:date ;
      {%- endif %}
      {%- if "end" in project.keys() %}
      dcso:end {{ project["end"]|tojson }}^^xsd:date ;
      {%- endif %}
      {%- if "funding" in project.keys() and project["funding"]|length > 0 %}
      dcso:hasFunding
      {%- for funding in project["funding"] %}
        [ a dcso:Funding ;
          dcso:hasFunderId
            [ a dcso:FunderId ;
              dcso:identifierType {{ funding["funder_id"]["type"]|tojson }} ;
              dct:identifier {{ funding["funder_id"]["identifier"]|tojson }} ;
            ] ;
          {%- if "funding_status" in funding.keys() %}
          dcso:fundingStatus {{ funding["funding_status"]|tojson }} ;
          {%- endif %}
          {%- if "grant_id" in funding.keys() %}
          dcso:hasGrantId
            [ a dcso:GrantId ;
              dcso:identifierType {{ funding["grant_id"]["type"]|tojson }} ;
              dct:identifier {{ funding["grant_id"]["identifier"]|tojson }} ;
            ] ;
          {%- endif -%}
        ] {{ ";" if loop.last else "," }}
      {%- endfor -%}
      {%- endif %}
    ] {{ ";" if loop.last else "," }}
  {%- endfor -%}
{%- endif %}
{%- if "dataset" in dmp.keys() and dmp["dataset"]|length > 0 %}
  dcso:hasDataset
  {%- for dataset in dmp["dataset"] %}
    [ a dcso:Dataset ;
      dcso:hasDatasetId
        [ a dcso:DatasetId ;
          dcso:identifierType {{ dataset["dataset_id"]["type"]|tojson }} ;
          dct:identifier {{ dataset["dataset_id"]["identifier"]|tojson }} ;
        ] ;
      dct:title {{ dataset["title"]|tojson }} ;
      {%- if "description" in dataset.keys() %}
      dct:description {{ dataset["description"]|tojson }} ;
      {%- endif %}
      {%- if "type" in dataset.keys() %}
      dcso:datasetType {{ dataset["type"]|tojson }} ;
      {%- endif %}
      dcso:personalData {{ dataset["personal_data"]|tojson }} ;
      dcso:sensitiveData {{ dataset["sensitive_data"]|tojson }} ;
      {%- if "data_quality_assurance" in dataset.keys()  and dataset["data_quality_assurance"]|length > 0 %}
      dcso:dataQualityAssurance {{ dataset["data_quality_assurance"]|map('tojson')|join(', ') }} ;
      {%- endif %}
      {%- if "issued" in dataset.keys() %}
      dct:issued {{ dataset["issued"]|tojson }} ;
      {%- endif %}
      {%- if "keyword" in dataset.keys() and dataset["keyword"]|length > 0 %}
      dct:keywords {{ dataset["keyword"]|map('tojson')|join(', ') }} ;
      {%- endif %}
      {%- if "language" in dataset.keys() %}
      dcso:language dcs-lang:{{ dataset["language"]}} ;
      {%- endif -%}
      {#{%- if "is_reused" in dataset.keys() %}
      dcso:isReused {{ dataset["is_reused"]|tojson }} ;
      {%- endif %} #}
      {%- if "preservation_statement" in dataset.keys() %}
      dcso:preservationStatement {{ dataset["preservation_statement"]|tojson }} ;
      {%- endif %}
      {%- if "security_and_privacy" in dataset.keys() and dataset["security_and_privacy"]|length > 0 %}
      dcso:hasSecurityPrivacy
      {%- for securityItem in dataset["security_and_privacy"] %}
        [ a dcso:SecurityPrivacy ;
          dct:title {{ securityItem["title"]|tojson }} ;
          dct:description {{ securityItem["description"]|tojson }} ;
        ] {{ ";" if loop.last else "," }}
      {%- endfor -%}
      {%- endif %}
      {%- if "technical_resource" in dataset.keys() and dataset["technical_resource"]|length > 0 %}
      dcso:hasTechnicalResource
      {%- for technicalItem in dataset["technical_resource"] %}
        [ a dcso:TechnicalResource ;
          foaf:name {{ technicalItem["name"]|tojson }} ;
          dct:description {{ technicalItem["description"]|tojson }} ;
        ] {{ ";" if loop.last else "," }}
      {%- endfor -%}
      {%- endif -%}
      {%- if "metadata" in dataset.keys() and dataset["metadata"]|length > 0 %}
      dcso:hasMetadata
      {%- for metadataItem in dataset["metadata"] %}
        [ a dcso:Metadata ;
         {%- if "language" in metadataItem.keys() %}
          dcso:language dcs-lang:{{ metadataItem["language"] }} ; 
          {%- endif %}
          {%- if "description" in metadataItem.keys() %}
          dct:description {{ metadataItem["description"]|tojson }} ;
          {%- endif %} 
          {%- if "metadata_standard_id" in metadataItem.keys() %}
          dcso:hasMetadataStandardId
          [ a dcso:MetadataStandardId ;
            dcso:identifierType {{ metadataItem["metadata_standard_id"]["type"]|tojson }} ;
            dct:identifier {{ metadataItem["metadata_standard_id"]["identifier"]|tojson }} ;
          ] ;
          {%- endif %}
        ] {{ ";" if loop.last else "," }}
      {%- endfor -%}
      {%- endif %}
      {%- if "distribution" in dataset.keys() and dataset["distribution"]|length > 0 %}
      dcso:hasDistribution
      {%- for distribution in dataset["distribution"] %}
        [ a dcso:Distribution ;
          dct:title {{ distribution["title"]|tojson }} ;
          dcso:dataAccess {{ distribution["data_access"]|tojson }} ;
          {%- if "access_url" in distribution.keys() %}
          dcat:accessURL {{ distribution["access_url"]|tojson }} ;
          {%- endif -%}
          {%- if "available_until" in distribution.keys() %}
          dcso:availableUntil {{ distribution["available_until"]|tojson }} ;
          {%- endif -%}
          {%- if "byte_size" in distribution.keys() %}
          dcat:byteSize {{ distribution["byte_size"]|tojson }} ;
          {%- endif -%}
          {%- if "description" in distribution.keys() %}
          dct:description {{ distribution["description"]|tojson }} ;
          {%- endif -%}
          {%- if "download_url" in distribution.keys() %}
          dcat:downloadURL {{ distribution["download_url"]|tojson }} ;
          {%- endif -%}
          {%- if "format" in distribution.keys() and distribution["format"]|length > 0 %}
          dct:format {{ distribution["format"]|map('tojson')|join(', ') }} ;
          {%- endif %}
          {%- if "license" in distribution.keys() and distribution["license"]|length > 0 %}
          dcso:hasLicense
          {%- for license in distribution["license"] %}
            [ a dcso:License ;
              dcso:licenseRef {{ license["license_ref"]|tojson }} ;
              dcso:startDate {{ license["start_date"]|tojson }}^^xsd:date ;
            ] {{ ";" if loop.last else "," }}
          {%- endfor -%}
          {%- endif %}
          {%- if "host" in distribution.keys() -%}
          dcso:hasHost
          [ a dcso:Host ;
            dcat:title {{ distribution["host"]["title"]|tojson }} ;
            dcso:url {{ distribution["host"]["url"]|tojson }} ;
            {%- if "availability" in distribution["host"].keys() %}
            dcso:availability {{ distribution["host"]["availability"]|tojson }} ;
            {%- endif %}
            {%- if "backup_frequency" in distribution["host"].keys() %}
            dcso:backupFrequency {{ distribution["host"]["backup_frequency"]|tojson }} ;
            {%- endif %}
            {%- if "backup_type" in distribution["host"].keys() %}
            dcso:backupType {{ distribution["host"]["backup_type"]|tojson }} ;
            {%- endif %}
            {%- if "certified_with" in distribution["host"].keys() %}
            dcso:certifiedWith {{ distribution["host"]["certified_with"]|tojson }} ;
            {%- endif %}
            {%- if "description" in distribution["host"].keys() %}
            dct:description {{ distribution["host"]["description"]|tojson }} ;
            {%- endif %}
            {%- if "geo_location" in distribution["host"].keys() %}
            dcso:geoLocation {{ distribution["host"]["geo_location"]|tojson }} ;
            {%- endif %}
            {%- if "pid_system" in distribution["host"].keys() and distribution["host"]["pid_system"]|length > 0 %}
            dcso:pidSystem {{ distribution["host"]["pid_system"]|map('tojson')|join(', ')  }} ;
            {%- endif %}
            {%- if "storage_type" in distribution["host"].keys() %}
            dcso:storageType {{ distribution["host"]["storage_type"]|tojson }} ;
            {%- endif %}
            {%- if "support_versioning" in distribution["host"].keys() %}
            dcso:supportVersioning {{ distribution["host"]["support_versioning"]|tojson }} ;
            {%- endif %}
          ] ;
          {%- endif %} 
        ] {{ ";" if loop.last else "," }}
      {%- endfor -%}
      {%- endif %} 
    ] {{ ";" if loop.last else "," }}
  {%- endfor -%}
{%- endif %}
{%- if "cost" in dmp.keys() and dmp["cost"]|length > 0 %}
  dcso:hasCost
  {%- for cost in dmp["cost"] %}
    [ a dcso:Cost ;
      {%- if "value" in cost.keys() %}
      dcso:value {{ cost["value"]|tojson }} ;
      {%- endif -%}
      {%- if "currency_code" in cost.keys() %}
      dcso:currency_code {{ cost["currency_code"]|tojson  }} ;
      {%- endif -%}
      {%- if "description" in cost.keys() %}
      dct:description {{ cost["description"]|tojson }} ;
      {%- endif %}
      dct:title {{ cost["title"]|tojson }} ;
    ] {{ ";" if loop.last else "," }}
  {%- endfor -%}
{%- endif %}
  dct:created "{{ dmp["created"] }}"^^xsd:dateTime ;
  dct:modified "{{ dmp["modified"] }}"^^xsd:dateTime .

# DMP identifier
<{{ uri_dmpid }}> 
  a dcso:DMPId ;
  dcso:identifierType {{ dmp["dmp_id"]["type"]|tojson }} ;
  dct:identifier {{ dmp["dmp_id"]["identifier"]|tojson }} .

# DMP contact
{%- if "contact" in dmp.keys() %}
{%- set uri_contact = make_uri(dmp["contact"]["contact_id"]["identifier"], dmp["contact"]["contact_id"]["type"]) %}
{%- set uri_contact_id = uri_contact ~ "/identifier" %}
<{{ uri_contact }}> a dcso:Contact ;
  dcso:hasContactId <{{ uri_contact_id }}> ;
  foaf:mbox {{ dmp["contact"]["mbox"]|tojson }} ;
  foaf:name {{ dmp["contact"]["name"]|tojson }} .

<{{ uri_contact_id }}> a dcso:ContactId ;
  dcso:identifierType {{ dmp["contact"]["contact_id"]["type"]|tojson }} ;
  dct:identifier {{ dmp["contact"]["contact_id"]["identifier"]|tojson }} .
{%- endif %}


