{% macro identifier(id) -%}
{
    "@type": [
        "adms:Identifier",
        "ccmm:Identifier"
    ],
    "@id": {{ id.iri| tojson }},
    "ccmm:Identifier.value": {{ id.value | tojson }},
    "ccmm:Identifier.inScheme": {
        "@type": "ccmm:IdentifierScheme",
        "@id": {{ id.inScheme.iri | tojson }},
        "ccmm:IdentifierScheme.label": {{ id.inScheme.label | tojson }}
    }
}
{%- endmacro %}