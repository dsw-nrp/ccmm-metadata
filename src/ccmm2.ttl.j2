  {%- for metadata in dataset["metadata"] %}
    {%- set uri_metadata_standard = make_uri(metadata["metadata_standard_id"]["identifier"], metadata["metadata_standard_id"]["type"]) %}
    {%- set uri_metadata_standard_id = uri_metadata_standard ~ "/identifier" %}
<{{ uri_metadata_standard_id }}> a dcso:MetadataStandardId ;
