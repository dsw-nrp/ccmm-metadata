{%- import "src/mapping/ccmm.j2" as mapping with context -%}
{%- set dmp = mapping.ccmm["dmp"] -%}

{
    "@context": {
        "dcterms": "http://purl.org/dc/terms/",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "locn": "http://www.w3.org/ns/locn/",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "foaf": "http://xmlns.com/foaf/0.1/",
        "dcat": "http://www.w3.org/ns/dcat#",
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "spdx": "http://spdx.org/rdf/terms#",
        "vcard": "http://www.w3.org/2006/vcard/ns#",
        "adms": "http://www.w3.org/ns/adms#",
        "prov": "http://www.w3.org/ns/prov#",
        "time": "http://www.w3.org/2006/time#",
        "datacite": "https://model.ccmm.cz/vocabulary/datacite#",
        "ccmm": "https://model.ccmm.cz/vocabulary/ccmm#"
    }
{%- if dmp.datasets|length > 0 -%}
    ,
    "@graph": [
        {%- for dataset in dmp.datasets %}
        {
            "@type": "dcat:Dataset"
            {%- if dataset.title -%}
            , 
            "dcterms:title": {{ dataset.title | tojson }}
            {%- endif -%}
            {%- if dataset.description -%}
            , 
            "datacite:hasDescription": [
                {
                    "@type": "datacite:Description"
                {%- if dataset.description.descriptionText -%}
                    ,
                    "datacite:descriptionText": {{ dataset.description.descriptionText | tojson }}
                {%- endif -%}
                {%- if dataset.description.descriptionType -%}
                    ,
                    "datacite:hasDescriptionType": { 
                            "@type": "datacite:DescriptionType",
                            "@id": {{ dataset.description.descriptionType.iri | tojson }},
                            "rdfs:label": {{ dataset.description.descriptionType.label | tojson }}
                        }
                {%- endif %}
                }
            ]
            {%- endif -%}
            {%- if dataset.identifiers|length > 0 -%}
            ,
            "ccmm:hasIdentifier": [
            {%- for identifier in dataset.identifiers %}
                {
                    "@type": "adms:Identifier"
                    {%- if identifier.value -%}
                    ,
                    "skos:notation": {{ identifier.value | tojson }}
                    {%- endif -%}
                    {%- if identifier.inScheme -%}
                    ,
                    "ccmm:inScheme": {
                        "@type": "ccmm:IdentifierScheme",
                        {%- if identifier.inScheme.iri %}
                        "@id": {{ identifier.inScheme.iri | tojson }},
                        {%- endif %}
                        "rdfs:label": {{ identifier.inScheme.label | tojson }}
                    }
                    {%- endif %}
                }{{ "," if not loop.last }}
            {%- endfor %}
            ]
            {%- endif %}
            {%- if dataset.language -%}
            ,
            "dcterms:language": {
                "@type": "dcterms:LinguisticSystem",
                {%- if dataset.language.iri %}
                "@id": {{ dataset.language.iri | tojson }},
                {%- endif %}
                "rdfs:label": {{ dataset.language.label | tojson }}
            }
            {%- endif %}
            {%- if dataset.resourceType -%}
            ,
            "dcterms:type": {
                "@type": "skos:Concept",
                {%- if dataset.resourceType.iri %}
                "@id": {{ dataset.resourceType.iri | tojson }},
                {%- endif %}
                "rdfs:label": {{ dataset.resourceType.label | tojson }}
            }
            {%- endif %}
            {%- if dataset.subjects|length > 0 -%}
            ,
            "datacite:hasSubject": [
                {%- for subject in dataset.subjects %}
                {
                    "@type": "datacite:Subject",
                    {%- if subject.iri %}
                    "@id": {{ subject.iri | tojson }},
                    {%- endif %}
                    "dcterms:title": {{ subject.title | tojson }}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif -%}
            {%- if dataset.timeReferences|length > 0 -%}
            ,
            "ccmm:hasTimeReference": [
                {%- for timeReference in dataset.timeReferences %}
                {
                    "@type": "time:Interval"
                    {%- if timeReference.hasDateType -%}
                    ,
                    "ccmm:hasDateType": {
                        "@type": "skos:Concept",
                        "@id": {{ timeReference.hasDateType.iri | tojson }},
                        "rdfs:label": {{ timeReference.hasDateType.label | tojson }}
                    }
                    {%- endif %}
                    {%- if timeReference.startTime -%}
                    ,
                    "time:hasBeginning": {
                        "@type": "time:Instant",
                        "time:inXSDDate": {{ timeReference.startTime | tojson }}
                    }
                    {%- endif %}
                    {%- if timeReference.endTime -%}
                    ,
                    "time:hasEnd": {
                        "@type": "time:Instant",
                        "time:inXSDDate": {{ timeReference.endTime | tojson }}
                    }
                    {%- endif %}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif -%}
            {%- if dataset.validationResult -%}
            ,
            "ccmm:hasValidationResult": {
                "@type": "ccmm:ValidationResult"
                {%- if dataset.validationResult.label -%}
                ,
                "rdfs:label": {{ dataset.validationResult.label | tojson }}
                {%- endif %}
                {%- if dataset.validationResult.description -%}
                ,
                "datacite:description": {{ dataset.validationResult.description | tojson }}
                {%- endif %}
            }
            {%- endif %}
            {%- if dataset.distributions -%}
            ,
            "dcat:distribution": [
                {%- for distribution in dataset.distributions %}
                {
                    "@type": "dcat:Distribution",
                    "dcterms:title": {{ distribution.title | tojson }},
                    "dcat:accessURL": {
                        "@id": {{ distribution.accessUrl | tojson }}
                    }
                    {%- if distribution.downloadUrl -%}
                    ,
                    "dcat:downloadURL": {
                        "@id": {{ distribution.downloadUrl | tojson }}
                    }
                    {%- endif -%}
                    {%- if distribution.byteSize -%}
                    ,
                    "dcat:byteSize": {{ distribution.byteSize | tojson }}
                    {%- endif -%}
                    {%- if distribution.format -%}
                    ,
                    "dcterms:format":
                        {
                            "@type": "dcterms:MediaTypeOrExtent",
                            "rdfs:label": {{ distribution.format.label | tojson }}
                            {%- if distribution.format.iri -%}
                            ,
                            "@id": {{ distribution.format.iri | tojson }}
                            {%- endif %}
                        }
                    {%- endif %}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif -%}
            {%- if dataset.fundingResources|length > 0 -%}
            ,
            "datacite:hasFundingReference": [
                {%- for fundingResource in dataset.fundingResources %}
                {
                    "@type": "datacite:FundingReference"
                    {%- if fundingResource.localIdentifier -%}
                    ,
                    "datacite:awardNumber": {{ fundingResource.localIdentifier | tojson }}
                    {%- endif %}
                    {%- if fundingResource.funder -%}
                    ,
                    "datacite:hasFunderIdentifier": [
                        {%- set organisation = dmp.entities.organisations | selectattr("name", "equalto", fundingResource.funder) | first -%}
                        {%- if organisation %}
                        {
                            "@type": "foaf:Organization",
                            "foaf:name": {{ organisation.name | tojson }}
                            {%- if organisation.iri -%}
                            ,
                            "@id": {{ organisation.iri | tojson }}
                            {%- endif %}
                            {%- if organisation.funderId -%}
                            ,
                            "ccmm:hasIdentifier": {
                                "@type": "adms:Identifier",
                                "skos:notation": {{ organisation.funderId.value | tojson }},
                                "ccmm:inScheme": {
                                    "@type": "ccmm:IdentifierScheme",
                                    "@id": {{ organisation.funderId.schema.iri | tojson }},
                                    "rdfs:label": {{ organisation.funderId.schema.label | tojson }}
                                }
                            }
                            {%- endif %}
                        }
                    ]
                        {%- endif -%}
                    {%- endif %}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif %}
            {%- if dataset.relatedResources|length > 0 -%}
            ,
            "ccmm:hasRelatedResource": [
            {%- for relatedResource in dataset.relatedResources %}
                {
                    "@type": "rdfs:Resource"
                {%- if relatedResource.title -%}
                    ,
                    "dcterms:title": {{ relatedResource.title | tojson }}
                {%- endif -%}
                {%- if relatedResource.url -%}
                    ,
                    "ccmm:resourceUrl": {{ relatedResource.url | tojson }}
                {%- endif -%}
                {%- if relatedResource.type -%}
                    ,
                    "dcterms:type": {
                        "@type": "skos:Concept",
                        "@id": {{ relatedResource.type.iri | tojson }},
                        "rdfs:label": {{ relatedResource.type.label | tojson }}
                    }
                {%- endif -%}
                {%- if relatedResource.relationType -%}
                    ,
                    "ccmm:hasType": {
                        "@type": "skos:Concept",
                        "@id": {{ relatedResource.relationType.iri | tojson }},
                        "rdfs:label": {{ relatedResource.relationType.label | tojson }}
                    }
                {%- endif %}
                }{{ "," if not loop.last }}
            {%- endfor %}
            ]
            {%- endif -%}
            {%- if dataset.termsOfUse -%}
            ,
            "ccmm:hasTermsOfUse": {  {## TODO: Terms of Use defined wrong in CCMM ##}
                "@type": "ccmm:TermsOfUse"
                {%- if dataset.termsOfUse.license -%}
                ,
                "dcterms:license": {
                    {%- if dataset.termsOfUse.license.iri %}
                    "@id": {{ dataset.termsOfUse.license.iri | tojson }}
                    {%- endif %}
                    {%- if dataset.termsOfUse.license.label -%}
                    ,
                    "rdfs:label": {{ dataset.termsOfUse.license.label | tojson }}
                    {%- endif -%}
                    ,
                    "@type": "ccmm:LicenseDocument"
                }
                {%- endif -%}
                {%- if dataset.termsOfUse.accessRights -%}
                ,
                "dcterms:accessRights": {
                    "@type": "dcterms:RightsStatement"
                    {%- if dataset.termsOfUse.accessRights.iri -%}
                    ,
                    "@id": {{ dataset.termsOfUse.accessRights.iri | tojson }}
                    {%- endif -%}
                    {%- if dataset.termsOfUse.accessRights.label -%}
                    ,
                    "rdfs:label": {{ dataset.termsOfUse.accessRights.label | tojson }}
                    {%- endif %}
                }
                {%- endif -%}
                {%- if dataset.termsOfUse.description -%}
                ,
                "datacite:description": {{ dataset.termsOfUse.description | tojson }}
                {%- endif %}
            }
            {%- endif -%}
            {%- if dataset.isDescribedBy|length > 0 -%}
            ,
            "dcterms:isDescribedBy": [
                {%- for isDescribedByItem in dataset.isDescribedBy %}
                {
                    "@type": "dcat:CatalogRecord"
                    {%- set metadata = isDescribedByItem -%}
                    {%- if metadata.language -%}
                    ,
                    "dcterms:language": {
                        "@id": {{ metadata.language | tojson }},
                        "@type": "dcterms:LinguisticSystem"
                    }
                    {%- endif %}
                    {%- if metadata.conformsToMetadataStandard -%}
                    ,
                    "dcterms:conformsTo": {
                        "@type": "dcterms:Standard"
                        {%- if metadata.conformsToMetadataStandard.iri -%}
                        ,
                        "@id": {{ metadata.conformsToMetadataStandard.iri | tojson }}
                        {%- endif %}
                    }
                    {%- endif %}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif -%}

            {%- if dataset.qualifiedRelations|length > 0 -%}
            ,
            "ccmm:qualifiedRelation": [
                {%- for qualifiedRelation in dataset.qualifiedRelations %}
                {
                    "@type": "ccmm:ResourceToAgentRelationship"
                    {%- if qualifiedRelation.role -%}
                    ,
                    "dcat:hadRole": {
                        "@id": {{ qualifiedRelation.role.iri | tojson }},
                        "rdfs:label": {{ qualifiedRelation.role.label | tojson }},
                        "@type": "skos:Concept"
                    }
                    {%- endif %}
                    {%- if qualifiedRelation.person %}
                        {%- for contributor in dmp.entities.contributors-%}
                            {%- if contributor.uuid == qualifiedRelation.person -%}
                    ,
                    "dcterms:relation": {
                        "@type": "prov:Person",
                        "foaf:name": {{ contributor.name | tojson }}
                        {%- if contributor.email -%}
                        ,
                        "dcat:contactPoint": {
                            "@type": "ccmm:ContactDetails",
                            "ccmm:email": {{ contributor.email | tojson }}
                        }
                        {%- endif -%}
                        {%- if contributor.identifier -%}
                        ,
                        "@id": {{ contributor.identifier.iri | tojson }},
                        "ccmm:hasIdentifier": {
                            "@type": "adms:Identifier",
                            "rdfs:value": {{ contributor.identifier.value | tojson }},
                            "ccmm:inScheme": {
                                "@type": "ccmm:IdentifierScheme",
                                "@id": {{ contributor.identifier.scheme.iri | tojson }},
                                "rdfs:label": {{ contributor.identifier.scheme.label | tojson }}
                            }
                        }
                        {%- endif -%}
                        {%- if contributor.affiliation -%}
                        ,
                        "ccmm:hasAffiliation": {
                            "@type": "prov:Organization",
                            "rdfs:label": {{ contributor.affiliation.name | tojson }}
                            {%- if contributor.affiliation.identifier -%}
                            ,
                            "@id": {{ contributor.affiliation.identifier.iri | tojson }},
                            "ccmm:hasIdentifier": {
                                "@type": "adms:Identifier",
                                "rdfs:value": {{ contributor.affiliation.identifier.value | tojson }},
                                "ccmm:inScheme": {
                                    "@type": "ccmm:IdentifierScheme",
                                    "@id": {{ contributor.affiliation.identifier.scheme.iri | tojson }},
                                    "rdfs:label": {{ contributor.affiliation.identifier.scheme.label | tojson }}
                                }
                            }
                            {%- endif %}
                        }
                        {%- endif %}
                    }
                        {%- endif %}
                        {%- endfor %}
                    {%- endif %}
                }{{ "," if not loop.last }}
                {%- endfor %}
            ]
            {%- endif %}        
        }{{ "," if not loop.last }}
        {%- endfor %}
    ]
    {%- endif %}
}